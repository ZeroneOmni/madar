{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "types": "off",
    "nsTypes": "off",
  },
  "ignoreBinaries": ["file", "mkfifo", "pkill", "pkg-config", "plutil", "sips"],
  "workspaces": {
    ".": {
      "project": ["*.{js,mjs,cjs,ts,mts,cts}", ".github/**/*.cjs"],
      "entry": [".coderabbit.config.ts", ".github/scripts/thread-transfer-report.cjs"],
      "vite": {
        "entry": [".github/**/*.test.cjs"],
      },
      "vitest": {
        "entry": [".github/**/*.test.cjs"],
      },
    },
    "scripts": {
      "entry": [
        "fixtures/*/*.js",
        "knip-schemas.ts",
        "sign-macos.ts",
        "verify-windows-desktop-artifact.ts",
      ],
      "ignoreDependencies": ["esbuild"],
      "ignore": [".knip-test-*/**"],
    },
    "apps/server": {
      "entry": [
        "src/bin.ts!",
        "scripts/cli.ts",
        "scripts/update-test-shard-weights.ts",
        "src/observability/*.ts",
        "src/resourceTelemetry/*.ts",
        "src/compileCache.ts",
        "src/serverLogger.ts",
        "src/assets/MediaFile.ts",
        "src/assets/NativeAppIconResolver.ts",
      ],
      "ignoreIssues": {
        "**/*.graphql.ts": ["exports", "types", "namespaceMembers"],
      },
      "ignoreDependencies": ["@effect/platform-node-shared", "@madar/web", "@napi-rs/keyring"],
    },
    "apps/desktop": {
      "entry": [
        "src/electron/WindowsForegroundFocusWorker.ts!",
        "src/boot.ts!",
        "src/compileCache.ts!",
        "src/main.ts!",
        "src/preload.ts!",
        "src/mac-permission-preload.ts!",
      ],
      "ignoreDependencies": ["electron-builder"],
    },
    "apps/web": {
      "entry": [
        "scripts/warm-dep-cache.ts",
        "src/components/ui/*.{ts,tsx}",
        "src/hooks/*.ts",
        "src/lib/*.ts",
        "src/themePalette.ts",
        "src/components/desktopUpdate.logic.ts",
        "src/components/desktopUpdate.toast.tsx",
        "src/state/desktopUpdate.ts",
        "src/appearanceFonts.ts",
        "src/appearanceContrast.ts",
        "test/render.tsx",
      ],
      "ignoreDependencies": ["playwright"],
      "ignoreIssues": {
        "src/components/ui/*.tsx": ["exports", "nsExports", "duplicates"],
      },
    },
    "infra/task-cache": {
      "ignore": ["vendor/**"],
      "entry": [
        "alchemy.run.ts!",
        "scripts/install.ts",
        "scripts/install-ci.ts",
        "src/runHook.ts",
        "src/flush.ts",
        "src/nativeRunHook.js",
        "src/preload.mjs",
      ],
    },
    "packages/*": {
      "includeEntryExports": true,
    },
    "packages/client-runtime": {
      "ignoreIssues": {
        "src/authorization/service.ts": ["exports"],
        "src/authorization/tokenStore.ts": ["exports"],
      },
    },
  },
}
