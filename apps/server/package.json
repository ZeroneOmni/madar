{
  "name": "madar",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZeroneOmni/madar",
    "directory": "apps/server"
  },
  "bin": {
    "madar": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../../packages --watch-path=package.json src/bin.ts",
    "dev:built": "vp run dev",
    "build:bundle": "vp pack",
    "build:exe": "node scripts/cli.ts build-exe",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@napi-rs/keyring": "^1.3.0",
    "effect": "catalog:",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@madar/contracts": "workspace:*",
    "@madar/shared": "workspace:*",
    "@madar/tailscale": "workspace:*",
    "@madar/web": "workspace:*",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
