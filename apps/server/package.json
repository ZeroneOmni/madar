{
  "name": "t3",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingdotgg/t3code",
    "directory": "apps/server"
  },
  "bin": {
    "t3": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../../packages --watch-path=package.json src/bin.ts",
    "dev:built": "vp run dev",
    "build:bundle": "vp pack",
    "build:exe": "node scripts/cli.ts build-exe",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@napi-rs/keyring": "^1.3.0",
    "effect": "catalog:",
    "jose": "catalog:",
    "proper-lockfile": "4.1.2",
    "stream-chain": "^4.2.5",
    "stream-json": "3.6.0",
    "undici": "catalog:",
    "yaml": "catalog:",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/tailscale": "workspace:*",
    "@t3tools/web": "workspace:*",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yauzl": "^3.4.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
