# Optional Madar development settings. Never commit credentials.
# MADAR_HOME=/absolute/path/to/isolated/madar-state
# MADAR_DEV_AUTH_TOKEN=choose-a-local-development-token
# MADAR_PORT=3773

# Analytics is disabled unless an endpoint and key are configured explicitly.
# MADAR_TELEMETRY_ENABLED=true
# MADAR_POSTHOG_HOST=https://analytics.example.com
# MADAR_POSTHOG_KEY=your-own-ingest-key
